.home { display: flex; min-height: 100vh; flex-direction: column; }.brand-stamp { display: flex; align-items: center; justify-content: center; width: 84rpx; height: 84rpx; margin-top: 42rpx; color: #a13e2e; border: 4rpx solid #a13e2e; font-family: "Songti SC", serif; font-size: 52rpx; font-weight: 700; }.intro { margin-top: 66rpx; color: #4a5d54; font-family: "Songti SC", serif; font-size: 32rpx; }.actions { display: flex; flex-direction: column; gap: 24rpx; margin-top: auto; padding-bottom: 50rpx; }.home-foot { color: #8c918a; font-size: 22rpx; letter-spacing: 2rpx; text-align: center; }.profile-mask { position: fixed; z-index: 20; inset: 0; display: flex; align-items: flex-end; background: rgba(22, 34, 29, 0.48); }.profile-sheet { width: 100%; box-sizing: border-box; padding: 42rpx 40rpx 56rpx; }.profile-title { color: #1d302a; font-family: "Songti SC", serif; font-size: 42rpx; font-weight: 700; text-align: center; }.profile-avatar-button { display: block; width: 132rpx; height: 132rpx; margin: 34rpx auto 26rpx; border-radius: 50%; overflow: hidden; }.profile-avatar, .profile-avatar-placeholder { width: 132rpx; height: 132rpx; border-radius: 50%; }.profile-avatar-placeholder { display: flex; align-items: center; justify-content: center; box-sizing: border-box; color: #fffdf6; background: #315e4c; font-size: 25rpx; }.profile-name-input { height: 84rpx; padding: 0 20rpx; border-bottom: 2rpx solid #1d4b3e; color: #1d302a; font-size: 30rpx; text-align: center; }.profile-actions { margin-top: 42rpx; }.profile-submit { height: 84rpx; font-size: 28rpx; }