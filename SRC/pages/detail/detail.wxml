<view class="page-shell">
	<view class="eyebrow">ROUND / RECORDS</view>
	<view class="page-title">局内明细</view>
	<view class="rule"></view>

	<view class="summary paper-card">
		<view>共 {{transfers.length}} 笔记录</view>
		<view>{{pendingCount ? '含 ' + pendingCount + ' 笔确认中' : '已全部核对'}}</view>
	</view>

	<view class="record-list">
		<view class="record" wx:for="{{transfers}}" wx:key="_id">
			<view class="record-top">
				<view class="record-name">{{item.direction}}</view>
				<view class="record-amount {{item.type}}">{{item.signedAmount}}</view>
			</view>
			<view class="record-meta">
				<text>{{item.time}}</text>
				<text>{{item.statusText}}</text>
			</view>
			<view class="record-note">点数小记：{{item.before}} 点 → {{item.after}} 点</view>
		</view>
	</view>
</view>