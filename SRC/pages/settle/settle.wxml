<view class="page-shell" wx:if="{{summary}}"><view class="eyebrow">ROUND / SETTLEMENT</view><view class="page-title">本局结算</view><view class="rule"></view><view class="settle-card paper-card"><view class="settle-row"><view class="settle-label">初始点数</view><view class="settle-value">{{summary.initial}}</view></view><view class="settle-row"><view class="settle-label">当前点数</view><view class="settle-value">{{summary.current}}</view></view><view class="settle-row total"><view class="settle-label">本局结余</view><view class="settle-value">{{summary.surplus}}</view></view></view><view class="settle-note">{{summary.pendingCount ? '有待确认记录' : '本局所有记录均已核对'}}</view><button wx:if="{{isOwner}}" class="primary-action finish" bindtap="finish">确认结算</button></view>