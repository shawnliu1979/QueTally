.table-head { display: flex; justify-content: space-between; align-items: flex-start; }.table-title { margin-top: 8rpx; font-family: "Songti SC", serif; font-size: 46rpx; font-weight: 700; }.round-state { padding: 9rpx 16rpx; color: #1d4b3e; border: 1rpx solid #719080; font-size: 22rpx; }
.my-score { display: flex; align-items: baseline; justify-content: center; margin-top: 50rpx; padding: 38rpx; }.score-caption { color: #6d7a71; font-size: 24rpx; }.large-score { margin: 0 15rpx; color: #1d4b3e; font-family: "Songti SC", serif; font-size: 82rpx; font-weight: 700; }
.member-title { margin: 48rpx 0 20rpx; color: #657269; font-size: 24rpx; letter-spacing: 2rpx; }.member-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16rpx; }.member-tile { display: flex; flex-direction: column; align-items: center; min-width: 0; padding: 34rpx 8rpx; }.member-name { margin-top: 15rpx; font-size: 28rpx; }
.bottom-links { display: flex; justify-content: space-between; margin-top: auto; padding-top: 94rpx; }.detail-link, .settle-link { color: #1d4b3e; font-size: 27rpx; text-decoration: underline; }.settle-link { color: #a13e2e; }
.modal-mask { position: fixed; z-index: 10; inset: 0; display: flex; align-items: flex-end; background: rgba(22, 34, 29, 0.48); }.transfer-modal { width: 100%; box-sizing: border-box; padding: 44rpx 40rpx 62rpx; background: #fffdf6; }.modal-kicker { color: #788078; font-size: 24rpx; }.modal-title, .detail-title { margin-top: 8rpx; font-family: "Songti SC", serif; font-size: 52rpx; font-weight: 700; }.amount-field { display: flex; align-items: center; margin-top: 40rpx; border-bottom: 2rpx solid #1d4b3e; }.amount-field input { flex: 1; height: 76rpx; font-family: "Songti SC", serif; font-size: 38rpx; }.amount-field text { color: #657269; font-size: 26rpx; }.modal-note, .transfer-note { margin-top: 16rpx; color: #8c918a; font-size: 22rpx; }.modal-actions { display: grid; grid-template-columns: 1fr 1fr; gap: 20rpx; margin-top: 48rpx; }.modal-button { height: 84rpx; font-size: 28rpx; }.incoming-score { margin-top: 38rpx; color: #1d7556; font-family: "Songti SC", serif; font-size: 64rpx; font-weight: 700; }
.detail-mask { align-items: flex-end; }.detail-modal { width: 100%; height: 78vh; box-sizing: border-box; padding: 40rpx; background: #fffdf6; }.modal-head, .detail-summary, .record-top, .record-meta { display: flex; justify-content: space-between; align-items: center; }.close-button { color: #1d4b3e; font-size: 25rpx; text-decoration: underline; }.detail-summary { margin-top: 32rpx; padding: 22rpx; color: #657269; background: #f5f0e4; font-size: 23rpx; }.detail-records { height: calc(78vh - 260rpx); }.detail-record { padding: 28rpx 8rpx; border-bottom: 1rpx solid #ded8c9; }.record-name { font-size: 29rpx; font-weight: 600; }.record-amount { font-family: "Songti SC", serif; font-size: 36rpx; font-weight: 700; }.in { color: #1d7556; }.out { color: #a13e2e; }.record-meta { margin-top: 8rpx; color: #858c84; font-size: 21rpx; }.record-note { margin-top: 16rpx; color: #657269; font-size: 23rpx; }