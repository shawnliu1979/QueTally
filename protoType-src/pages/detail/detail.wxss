.summary { display: flex; justify-content: space-between; padding: 24rpx; color: #55645b; font-size: 24rpx; }.record-list { margin-top: 26rpx; background: #fffdf6; border-top: 2rpx solid #1d4b3e; }.record { padding: 30rpx 8rpx; border-bottom: 1rpx solid #ded8c9; }.record-top, .record-meta { display: flex; justify-content: space-between; align-items: center; }.record-name { font-size: 32rpx; font-weight: 600; }.record-amount { font-family: "Songti SC", serif; font-size: 38rpx; font-weight: 700; }.in { color: #1d7556; }.out { color: #a13e2e; }.record-meta { margin-top: 8rpx; color: #858c84; font-size: 22rpx; }.record-note { margin-top: 18rpx; color: #657269; font-size: 24rpx; }