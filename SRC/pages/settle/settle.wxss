.settle-card { padding: 6rpx 28rpx; }.settle-row { display: flex; align-items: baseline; height: 116rpx; border-bottom: 1rpx solid #e3ddcf; }.settle-row:last-child { border: 0; }.settle-label { color: #657269; font-size: 28rpx; }.settle-value { margin-left: auto; color: #1d4b3e; font-family: "Songti SC", serif; font-size: 51rpx; font-weight: 700; }.total .settle-value { color: #a13e2e; }.settle-note { margin-top: 24rpx; color: #6d7a71; font-size: 24rpx; text-align: center; }.finish { margin-top: 72rpx; }