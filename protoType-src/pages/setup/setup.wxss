.section-label {
  margin-bottom: 18rpx;
  color: #657269;
  font-size: 24rpx;
  letter-spacing: 3rpx;
}

.players-card { padding: 0 28rpx; }
.player-row { display: flex; align-items: center; height: 112rpx; border-bottom: 1rpx solid #e4decf; }
.player-row:last-child { border-bottom: 0; }
.avatar { display: flex; align-items: center; justify-content: center; width: 58rpx; height: 58rpx; color: #fffdf6; border-radius: 50%; font-size: 24rpx; }
.green { background: #315e4c; }.red { background: #aa5547; }.yellow { background: #b78938; }.blue { background: #4c7482; }
.player-name { margin-left: 20rpx; font-size: 30rpx; }.player-mark { margin-left: auto; color: #8a9189; font-size: 23rpx; }
.score-label { margin-top: 48rpx; }
.score-card { display: flex; align-items: center; height: 106rpx; padding: 0 28rpx; }
.score-input { flex: 1; color: #1d4b3e; font-family: "Songti SC", serif; font-size: 52rpx; font-weight: 700; }
.score-unit { color: #788078; font-size: 24rpx; }
.wait-tip { margin-top: 18rpx; color: #a13e2e; font-size: 24rpx; }
.setup-actions { display: flex; flex-direction: column; gap: 22rpx; margin-top: 64rpx; }
.action-disabled { color: #a9ada6; background: #d8d8d1; }