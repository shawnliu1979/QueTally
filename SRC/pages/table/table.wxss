.table-page { display: flex; flex-direction: column; }.table-head { display: flex; justify-content: space-between; align-items: flex-start; }.table-title { margin-top: 8rpx; font-family: "Songti SC", serif; font-size: 46rpx; font-weight: 700; }.round-state { padding: 9rpx 16rpx; color: #1d4b3e; border: 1rpx solid #719080; font-size: 22rpx; }.my-score { display: flex; align-items: baseline; justify-content: center; margin-top: 50rpx; padding: 38rpx; }.score-caption { color: #6d7a71; font-size: 24rpx; }.large-score { margin: 0 15rpx; color: #1d4b3e; font-family: "Songti SC", serif; font-size: 82rpx; font-weight: 700; }.member-title { margin: 48rpx 0 20rpx; color: #657269; font-size: 24rpx; letter-spacing: 2rpx; }.member-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16rpx; }.member-tile { display: flex; flex-direction: column; align-items: center; min-width: 0; padding: 34rpx 8rpx; }.avatar, .avatar-image { width: 58rpx; height: 58rpx; border-radius: 50%; }.avatar { display: flex; align-items: center; justify-content: center; color: #fffdf6; font-size: 24rpx; }.green { background: #315e4c; }.red { background: #aa5547; }.yellow { background: #b78938; }.blue { background: #4c7482; }.member-name { margin-top: 15rpx; font-size: 28rpx; }.bottom-links { display: flex; justify-content: space-between; margin-top: auto; padding-top: 94rpx; }.detail-link, .settle-link { color: #1d4b3e; font-size: 27rpx; text-decoration: underline; }.settle-link { color: #a13e2e; }.modal-mask { position: fixed; z-index: 10; inset: 0; display: flex; align-items: flex-end; background: rgba(22, 34, 29, 0.48); }.transfer-modal { width: 100%; box-sizing: border-box; padding: 44rpx 40rpx 62rpx; background: #fffdf6; }.modal-kicker { color: #788078; font-size: 24rpx; }.modal-title { margin-top: 8rpx; font-family: "Songti SC", serif; font-size: 52rpx; font-weight: 700; }.amount-field { display: flex; align-items: center; margin-top: 40rpx; border-bottom: 2rpx solid #1d4b3e; }.amount-field input { flex: 1; height: 76rpx; font-family: "Songti SC", serif; font-size: 38rpx; }.amount-field text { color: #657269; font-size: 26rpx; }.modal-note, .transfer-note { margin-top: 16rpx; color: #8c918a; font-size: 22rpx; }.modal-actions { display: grid; grid-template-columns: 1fr 1fr; gap: 20rpx; margin-top: 48rpx; }.modal-button { height: 84rpx; font-size: 28rpx; }.incoming-score { margin-top: 38rpx; color: #1d7556; font-family: "Songti SC", serif; font-size: 64rpx; font-weight: 700; }